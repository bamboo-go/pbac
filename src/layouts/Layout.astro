---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | PBaC - Physical Body as a Code</title>
  </head>
  <body class="bg-[#0d1117] text-zinc-300 font-sans min-h-screen selection:bg-emerald-500 selection:text-black">
    <header class="border-b border-zinc-800 bg-[#161b22]/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between font-mono text-sm">
        <a href="/" class="flex items-center gap-2 font-bold text-zinc-100 hover:text-emerald-400 transition-colors">
          <span class="text-emerald-500">❯</span> PBaC
        </a>
        <div class="flex items-center gap-5 text-xs">
          <a href="/" class="hover:text-emerald-400 transition-colors">Telemetry</a>
          <a href="https://github.com/xyna-bpinelab/pbac" target="_blank" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded transition-colors">
            Fork on GitHub ↗
          </a>
        </div>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
</html>
