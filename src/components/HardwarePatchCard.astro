---
interface Props {
  name: string;
  category: string;
  effect: string;
  affiliateUrl: string;
  priceRange: string;
}

const { name, category, effect, affiliateUrl, priceRange } = Astro.props;
---

<div class="my-6 border border-zinc-800 bg-[#161b22] rounded-lg p-5 font-mono text-sm text-zinc-300 shadow-xl">
  <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
    <span class="text-xs uppercase tracking-wider text-emerald-400 font-bold flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      [Hardware Patch Tool]
    </span>
    <span class="text-xs text-zinc-500">{category}</span>
  </div>
  <div class="py-4 space-y-2">
    <h4 class="text-base font-bold text-zinc-100">{name}</h4>
    <p class="text-xs text-zinc-400 leading-relaxed">デバッグ効果: {effect}</p>
    <div class="text-xs text-zinc-500">想定バジェット: {priceRange}</div>
  </div>
  <a 
    href={affiliateUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    class="block text-center w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-zinc-950 font-bold rounded transition-colors text-xs tracking-wider"
  >
    スペック・公式ストアを確認する ↗
  </a>
</div>
